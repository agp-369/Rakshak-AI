      "description": "Stratified held-out evaluation"
    },
    {
      "path": "alert_actions.jsonl",
      "description": "Alert interpretation examples"
    },
    {
      "path": "distress.jsonl",
      "description": "Voice distress intent examples"
    },
    {
      "path": "survival_qa.jsonl",
      "description": "Grounded RAG examples"
    },
    {
      "path": "situation_brief.jsonl",
      "description": "Situation brief examples"
    },
    {
      "path": "stats.json",
      "description": "Dataset statistics"
